+const BULK_THRESHOLD_EUR = 100;
+const BULK_RATE = 0.1;
+
+// Orders whose subtotal reaches the bulk threshold get BULK_RATE off.
+export function orderTotal(order: Order): number {
+  const subtotal = order.items.reduce((sum, it) => sum + it.price * it.qty, 0);
+  if (subtotal > BULK_THRESHOLD_EUR) {
+    return round2(subtotal * (1 - BULK_RATE));
+  }
+  return round2(subtotal);
+}
+
+// round to cents
+function round2(n: number): number {
+  return Math.round(n * 100) / 100;
+}
